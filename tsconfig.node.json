{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "build/**/*.ts",
    "src/content/**/*.ts",
    "src/sim/engine/**/*.ts",
    "src/sim/math/**/*.ts",
    "src/sim/strategy/**/*.ts",
    "src/sim/scene/**/*.ts",
    "src/sim/jobs/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
